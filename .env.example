# Supabase (same project as LOTPILOT — LOTAGENT uses isolated la_* tables)
NEXT_PUBLIC_SUPABASE_URL=https://gqgamvavrqavifthxglc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used for seed/admin scripts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional licensed providers — mock adapters are used when these are empty.
VIN_PROVIDER_API_KEY=
VALUATION_PROVIDER_API_KEY=
COMPARABLES_PROVIDER_API_KEY=
MAPS_PROVIDER_API_KEY=
TRANSPORT_QUOTE_API_KEY=
VEHICLE_HISTORY_API_KEY=

# Set to "true" to force demo mode even if Supabase keys are present.
NEXT_PUBLIC_FORCE_DEMO=
